# Generated by Cargo
# 编译产物与依赖目录
/target/
**/target/
debug/
release/

# Cargo 锁文件（库项目建议忽略；二进制项目通常提交）
# Cargo.lock

# 备份文件（cargo fix / rustfmt 生成）
**/*.rs.bk
**/*.pdb

# Rustfmt / clippy 备份
*.orig
*.rej

# MSVC / Windows 调试与构建产物
*.exe
*.dll
*.lib
*.pdb
*.ilk
*.exp
*.o
*.obj

# 编辑器 / IDE
.vscode/
.idea/
*.iml
*.swp
*.swo

# 系统文件
.DS_Store
Thumbs.db

# ---------- Python / uv ----------
# 虚拟环境
.venv/
venv/
env/

# 字节码与缓存
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 构建与打包产物
build/
dist/
*.egg-info/
.eggs/

# Jupyter
.ipynb_checkpoints/

# 环境变量与密钥
.env
.env.*
