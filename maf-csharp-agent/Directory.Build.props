<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <!-- 各 lab 目录下的 config.json 自动复制到输出目录（与 study-agent 的 config.json 机制对齐） -->
  <ItemGroup>
    <None Include="config.json" Condition="Exists('config.json')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
