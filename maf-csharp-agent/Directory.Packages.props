<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- MAF 核心（版本与 NuGet 最新 GA 对齐，各 lab 统一引用） -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.28.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Workflows" Version="1.28.0" />
    <!-- Microsoft.Extensions.AI：OpenAI 兼容客户端接入 -->
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.0" />
    <!-- Azure 生产部署（lab19） -->
    <PackageVersion Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageVersion Include="Azure.Identity" Version="1.17.0" />
    <!-- MCP 客户端（lab6） -->
    <PackageVersion Include="ModelContextProtocol" Version="2.4.0" />
  </ItemGroup>
</Project>
